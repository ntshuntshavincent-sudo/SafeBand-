# SafeBand Environment Configuration
PORT=3000
NODE_ENV=development

# Campus Responder Authorization Code (used by university security & CPF consoles)
RESPONDER_ACCESS_CODE=CAMPUS-SEC-2026

# Gemini API Key (Server-side only, for incident statements and AI risk forecasting)
GEMINI_API_KEY=

# Real-time SMS Gateway Configuration (Twilio)
# Set your Twilio credentials below to dispatch live carrier SMS to South African mobile numbers (+27)
# If left blank, SafeBand will run in honest simulated mode with instant 1-tap client Web Share / WhatsApp fallbacks.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional Web Push (VAPID) keys for PWA notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@safeband.co.za
